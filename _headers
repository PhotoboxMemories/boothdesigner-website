# Cloudflare Pages: Antwort-Kopfzeilen (seit 03.11.2026). Versionierte Dateien (?v=…) und Bilder dürfen der Browser lange behalten,
# HTML bleibt bei der Standard-Einstellung (bei jedem Aufruf prüfen). Keine X-Frame-Options: das Studio wird bei Kunden per iframe eingebettet.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
/vendor/*
  Cache-Control: public, max-age=31536000, immutable
/studio/media/*
  Cache-Control: public, max-age=31536000, immutable
/studio/assets/*
  Cache-Control: public, max-age=86400
/beispiele/*
  Cache-Control: public, max-age=86400
/video/*
  Cache-Control: public, max-age=2592000
/lang/*
  Cache-Control: public, max-age=604800
/style.css
  Cache-Control: public, max-age=604800
/i18n.js
  Cache-Control: public, max-age=604800
/sprache.js
  Cache-Control: public, max-age=604800
/einwilligung.js
  Cache-Control: public, max-age=604800
/zaehler.js
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
/*.png
  Cache-Control: public, max-age=604800
/konto/*
  X-Robots-Tag: noindex
